# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Environment files
# NOTE: the negation must come last — gitignore applies the last matching rule,
# so a later broad `.env*` would otherwise re-ignore the example file.
.env
.env.*
.env*
!.env.example
!**/.env.example

# Phase 1/2/3 planning artifacts — local only
output/

# Playwright run artifacts — regenerated per run, never source.
# test-results/.last-run.json slipped into a commit on 2026-08-10 because these
# were not ignored.
test-results/
playwright-report/
blob-report/

# Coverage reports — regenerated per run
coverage/
.gstack/
dist-prerender

# Agent worktrees. These are throwaway checkouts, but because each one is a git
# repo of its own, `git add .claude` recorded them as gitlinks (mode 160000) —
# two of them sat in the tree until 2026-08-28. A gitlink whose branch is later
# deleted points at an unreachable SHA, so anyone cloning gets a broken
# submodule-shaped entry that `git submodule` can't resolve either.
.claude/worktrees/

# Design canvas payload. `design/*.dc.html` + `design/canvas.json` are the
# sources; the seeded page is a ~2.4 MB generated artefact that `seed-canvas.mjs`
# rebuilds from them, so it never belongs in the tree.
design/*.html
!design/*.dc.html
