# Smart Quote API — local development environment
#
#   cp .env.example .env
#
# Loaded by dotenv-rails. `.env` is gitignored — never commit real secrets.
# Values already set in your shell win over this file.
#
# Nothing here is required just to boot the server and run the quote calculator.
# Each section notes what breaks if you leave it unset.

# --- Frontend link generation -------------------------------------------------
# Base URL used to build magic-link / auth URLs in outgoing email.
# config/environments/development.rb already defaults this to localhost:5173,
# so you only need it here when your Vite dev server runs on another port.
FRONTEND_URL=http://localhost:5173

# --- Database -----------------------------------------------------------------
# Defaults to the local PostgreSQL socket via config/database.yml.
# Set this only to point at a non-default database.
# DATABASE_URL=postgres://localhost/smart_quote_api_development

# --- Outbound email -----------------------------------------------------------
# Unset: mail is written to the Rails log instead of being delivered.
# Needed to actually receive magic-link / password emails.
# RESEND_API_KEY=re_xxxxxxxx
# MAILER_FROM=noreply@bridgelogis.com

# --- AI chatbot ---------------------------------------------------------------
# Unset: POST /api/v1/chat returns an error. Everything else works.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Exchange rates -----------------------------------------------------------
# Unset: exchange-rate lookups fall back to DEFAULT_EXCHANGE_RATE.
# OPEN_EXCHANGE_APP_ID=xxxxxxxx

# --- Intercom ------------------------------------------------------------------
# Unset: Intercom identity verification (HMAC) is skipped.
# INTERCOM_SECRET_KEY=xxxxxxxx

# --- CORS / auth hardening ----------------------------------------------------
# Defaults are development-friendly; override only when reproducing a
# production CORS or cookie issue locally.
# CORS_ORIGINS=http://localhost:5173
# AUTH_ORIGIN_CHECK=true
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=none
# APP_HOST=localhost

# --- Admin promotion ----------------------------------------------------------
# Shared secret guarding the admin-promotion path. Unset: promotion is refused.
# ADMIN_PROMOTE_SECRET=xxxxxxxx
